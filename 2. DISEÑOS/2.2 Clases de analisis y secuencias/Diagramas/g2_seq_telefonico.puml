@startuml
title Secuencia de análisis - Tomar pedido telefónico
actor "Operador de llamadas" as Operador
boundary "PantallaPedidoTelefonico" as UI
control "ControlPedidoTelefonico" as Ctrl
entity "Producto" as Prod
entity "Pedido" as Ped
database "RepositorioPedido" as Repo
boundary "PantallaCocina" as UICocina

Operador -> UI : agregarProducto(producto, cantidad)
Operador -> UI : ingresarDatosEntrega(datosCliente, datosEntrega)
Operador -> UI : clickRegistrarPedido()
UI -> Ctrl : registrarPedidoTelefonico(productos, cantidades, datosCliente, datosEntrega, observaciones)
Ctrl -> Prod : estaDisponible()
Prod --> Ctrl : true
Ctrl -> Ctrl : validarPedido(productos)
Ctrl -> Ped : new Pedido(productos, cantidades, datosCliente, datosEntrega, observaciones)
note right of Ped : estado = "pendiente"
Ctrl -> Repo : guardar(Ped)
Repo --> Ctrl : guardado correcto
Ctrl -> UICocina : notificarNuevoPedido(Ped)
Ctrl --> UI : Resultado exitoso
UI --> Operador : mostrarMensaje("Pedido registrado")
@enduml
