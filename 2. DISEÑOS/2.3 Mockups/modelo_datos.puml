@startuml
hide circle
skinparam linetype ortho
skinparam shadowing false
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #3B2A20
  HeaderBackgroundColor #FDEBDD
}
title Modelo de datos propuesto - Sistema de Gestión de Pedidos Bocatto

entity "USUARIO" as usuario {
  * id_usuario : INT <<PK>>
  --
  * nombre_usuario : VARCHAR(50)
  * contrasena_hash : VARCHAR(255)
  * rol : VARCHAR(20)
}
entity "MESA" as mesa {
  * numero_mesa : INT <<PK>>
  --
  * codigo_qr : VARCHAR(100)
}
entity "PRODUCTO" as producto {
  * id_producto : INT <<PK>>
  --
  * nombre : VARCHAR(100)
  * precio : DECIMAL(8,2)
  * disponible : BOOLEAN
}
entity "PROMOCION" as promocion {
  * id_promocion : INT <<PK>>
  --
  * descripcion : VARCHAR(200)
  * vigente : BOOLEAN
}
entity "PEDIDO" as pedido {
  * id_pedido : INT <<PK>>
  --
  numero_mesa : INT <<FK>>
  id_usuario : INT <<FK>>
  * canal : VARCHAR(10)
  datos_cliente : VARCHAR(150)
  datos_entrega : VARCHAR(200)
  observaciones : VARCHAR(250)
  * estado : VARCHAR(25)
  metodo_pago : VARCHAR(25)
  total : DECIMAL(8,2)
  * fecha_hora : DATETIME
}
entity "DETALLE_PEDIDO" as detalle {
  * id_pedido : INT <<PK, FK>>
  * id_producto : INT <<PK, FK>>
  --
  * cantidad : INT
  * precio_unitario : DECIMAL(8,2)
}
mesa |o..o{ pedido : "tiene"
usuario |o..o{ pedido : "registra"
pedido ||..|{ detalle : "contiene"
producto ||..o{ detalle : "se pide en"
note bottom of pedido
canal: mesa, telefono o qr
estado: pendiente, en preparacion, listo,
listo para entregar, pagado
end note
@enduml
