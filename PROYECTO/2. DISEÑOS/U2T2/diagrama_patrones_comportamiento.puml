@startuml
title U2T2 - CRUD Estudiante en capas, con una carpeta por patron (observer, strategy, command)

skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam shadowing false
left to right direction

package "presentacion" {
  class PruebaCrudEstudiantes {
    + main(args: String[]): void
  }
  class PruebaPatronesComportamiento {
    + main(args: String[]): void
  }
  class MenuConsolaEstudiantes {
    + main(args: String[]): void
  }
  class CRUDEstudiantesGUI {
    - control: ControlEstudiante
    - invocador: InvocadorComandos
    - alRecibirEvento(evento): void
    + main(args: String[]): void
  }
}

package "logica" {
  class ControlEstudiante {
    - repo: RepositorioEstudiante
    - observadores: List<ObservadorEstudiante>
    - estrategiaBusqueda: EstrategiaBusquedaEstudiante
    + agregarEstudiante(id, nombre, edad): String
    + actualizarEstudiante(id, nombre, edad): String
    + eliminarEstudiante(id): String
    + listarTodos(): List<Estudiante>
    + validarDatos(id, nombre, edad): boolean
    + validarId(id: String): boolean
    + cambiarEstrategiaBusqueda(e): void
    + buscarEstudiantes(criterio): List<Estudiante>
    + agregarObservador(o): void
    + notificarObservadores(evento): void
  }

  package "observer" <<Frame>> {
    interface SujetoEventosEstudiante {
      + agregarObservador(o): void
      + quitarObservador(o): void
      + notificarObservadores(evento): void
    }
    interface ObservadorEstudiante {
      + actualizar(evento: EventoEstudiante): void
    }
    class ObservadorAuditoriaEstudiante {
      - bitacora: List<String>
    }
    class ObservadorNotificacionEstudiante {
      - ultimaNotificacion: String
    }
    class EventoEstudiante {
      - tipo: TipoEventoEstudiante
      - estudiante: Estudiante
      - mensaje: String
    }
    enum TipoEventoEstudiante {
      REGISTRADO
      ACTUALIZADO
      ELIMINADO
      DESHECHO
    }
  }

  package "strategy" <<Frame>> {
    interface EstrategiaBusquedaEstudiante {
      + buscar(lista, criterio): List<Estudiante>
    }
    class BusquedaPorIdStrategy
    class BusquedaPorNombreStrategy
    class BusquedaPorRangoEdadStrategy
  }

  package "command" <<Frame>> {
    interface ComandoEstudiante {
      + ejecutar(): String
      + deshacer(): String
    }
    class RegistrarEstudianteComando
    class ActualizarEstudianteComando
    class EliminarEstudianteComando
    class InvocadorComandos {
      - historial: Deque<ComandoEstudiante>
      + ejecutar(c: ComandoEstudiante): String
      + deshacerUltimo(): String
    }
  }
}

package "datos" {
  class RepositorioEstudiante {
    - estudiantes: List<Estudiante>
    + guardar(e): void
    + buscarPorId(id): Estudiante
    + actualizar(e): void
    + eliminar(id): void
    + listarTodos(): List<Estudiante>
  }
}

package "modelo" {
  class Estudiante {
    - id: String {final, ej. L00434011}
    - nombre: String
    - edad: int
  }
}

' Capas
PruebaCrudEstudiantes --> ControlEstudiante : prueba
PruebaPatronesComportamiento --> InvocadorComandos : usa
MenuConsolaEstudiantes --> InvocadorComandos : usa
MenuConsolaEstudiantes --> ControlEstudiante : busca / lista
CRUDEstudiantesGUI --> InvocadorComandos : usa
CRUDEstudiantesGUI --> ControlEstudiante : busca / lista
CRUDEstudiantesGUI ..> ObservadorEstudiante : se suscribe como observador
ControlEstudiante --> RepositorioEstudiante : coordina
RepositorioEstudiante o--> Estudiante : almacena

' Observer
ControlEstudiante ..|> SujetoEventosEstudiante
ControlEstudiante o--> ObservadorEstudiante : notifica
ObservadorAuditoriaEstudiante ..|> ObservadorEstudiante
ObservadorNotificacionEstudiante ..|> ObservadorEstudiante
ObservadorEstudiante ..> EventoEstudiante
EventoEstudiante --> TipoEventoEstudiante

' Strategy
ControlEstudiante o--> EstrategiaBusquedaEstudiante : estrategia actual
BusquedaPorIdStrategy ..|> EstrategiaBusquedaEstudiante
BusquedaPorNombreStrategy ..|> EstrategiaBusquedaEstudiante
BusquedaPorRangoEdadStrategy ..|> EstrategiaBusquedaEstudiante

' Command
InvocadorComandos o--> ComandoEstudiante : historial
RegistrarEstudianteComando ..|> ComandoEstudiante
ActualizarEstudianteComando ..|> ComandoEstudiante
EliminarEstudianteComando ..|> ComandoEstudiante
RegistrarEstudianteComando --> ControlEstudiante : receptor
ActualizarEstudianteComando --> ControlEstudiante : receptor
EliminarEstudianteComando --> ControlEstudiante : receptor
@enduml
