@startuml
title Secuencia de análisis - Tomar pedido en mesa
actor "Mesero" as Mesero
boundary "PantallaPedido" as UI
control "ControlPedido" as Ctrl
entity "Mesa" as Mesa
entity "Producto" as Prod
entity "Pedido" as Ped
database "RepositorioPedido" as Repo
boundary "PantallaCocina" as UICocina

Mesero -> UI : seleccionarMesa(numeroMesa)
Mesero -> UI : agregarProducto(producto, cantidad)
Mesero -> UI : clickRegistrarPedido()
UI -> Ctrl : registrarPedido(numeroMesa, productos, cantidades, observaciones)
Ctrl -> Mesa : validarNumero(numeroMesa)
Mesa --> Ctrl : true
Ctrl -> Prod : estaDisponible()
Prod --> Ctrl : true
Ctrl -> Ctrl : validarPedido(productos)
Ctrl -> Ped : new Pedido(numeroMesa, productos, cantidades, observaciones)
note right of Ped : estado = "pendiente"
Ctrl -> Repo : guardar(Ped)
Repo --> Ctrl : guardado correcto
Ctrl -> UICocina : notificarNuevoPedido(Ped)
Ctrl --> UI : Resultado exitoso
UI --> Mesero : mostrarMensaje("Pedido registrado")
@enduml
