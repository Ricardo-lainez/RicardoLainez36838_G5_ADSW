@startuml
hide circle
skinparam linetype ortho
skinparam shadowing false
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #3B2A20
  HeaderBackgroundColor #FDEBDD
}
title Modelo de datos propuesto - Sistema Bocatto (RF002, RF004, RF005 y RF006)

entity "MESA" as mesa {
  * numero_mesa : INT <<PK>>
  --
  * codigo_qr : VARCHAR(100)
}
entity "PRODUCTO" as producto {
  * id_producto : INT <<PK>>
  --
  * nombre : VARCHAR(100)
  * precio : DECIMAL(8,2)
  * disponible : BOOLEAN
}
entity "PROMOCION" as promocion {
  * id_promocion : INT <<PK>>
  --
  * descripcion : VARCHAR(200)
  * vigente : BOOLEAN
}
entity "PEDIDO" as pedido {
  * id_pedido : INT <<PK>>
  --
  * numero_mesa : INT <<FK>>
  * canal : VARCHAR(10)
  observaciones : VARCHAR(250)
  * estado : VARCHAR(25)
  metodo_pago : VARCHAR(25)
  total : DECIMAL(8,2)
  * fecha_hora : DATETIME
}
entity "DETALLE_PEDIDO" as detalle {
  * id_pedido : INT <<PK, FK>>
  * id_producto : INT <<PK, FK>>
  --
  * cantidad : INT
  * precio_unitario : DECIMAL(8,2)
}
mesa ||..o{ pedido : "tiene"
pedido ||..|{ detalle : "contiene"
producto ||..o{ detalle : "se pide en"
note bottom of pedido
canal: mesa o qr
estado: pendiente, en preparacion, listo,
listo para entregar, pagado
end note
@enduml
